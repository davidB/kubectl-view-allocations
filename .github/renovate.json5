{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":semanticCommits"],
  // only update crates (Cargo.toml) and github-actions (workflows)
  enabledManagers: ["cargo", "github-actions"],
  // only direct dependencies: no lock file maintenance (transitive updates)
  lockFileMaintenance: { enabled: false },
  // no schedule: runs are controlled by .github/workflows/renovate.yaml (weekly + manual)
  // runs are weekly: don't spread PR creation over several runs (default limit is 2 per hour)
  prHourlyLimit: 0,
  automerge: true,
  automergeType: "pr",
  packageRules: [
    {
      groupName: "kube & k8s",
      matchManagers: ["cargo"],
      matchPackageNames: ["/^kube/", "/^k8s-/"],
      // kube and k8s-openapi must be bumped together, even when one is a major update and the other is not
      separateMajorMinor: false,
    },
  ],
}
